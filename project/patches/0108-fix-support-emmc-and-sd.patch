diff --git a/target/linux/imx/image/bootscript-imx6ull-atk-emmc b/target/linux/imx/image/bootscript-imx6ull-atk-mmc
similarity index 85%
rename from target/linux/imx/image/bootscript-imx6ull-atk-emmc
rename to target/linux/imx/image/bootscript-imx6ull-atk-mmc
index e6e33dccfc..c4623eb166 100644
--- a/target/linux/imx/image/bootscript-imx6ull-atk-emmc
+++ b/target/linux/imx/image/bootscript-imx6ull-atk-mmc
@@ -5,15 +5,21 @@ echo "ATK-imx6ull OpenWrt boot script"
 
 # Set console variable for both UART and HDMI
 setenv console "console=ttymxc0,115200 console=tty0"
-setenv fdt_name imx6ull-atk-emmc.dtb
-setenv mmcdev 0
+setenv fdt_name imx6ull-atk-mmc.dtb
 setenv mmcrootpart 2
 setenv kernel_addr_r 0x80800000
 setenv fdt_addr_r 0x83000000
-part uuid mmc ${mmcdev}:${mmcrootpart} uuid
 
 # Set correct devtype and partition
 if test ${devtype} != mmc; then setenv devtype mmc; fi
+# Priority boot from SD card
+if mmc dev 0; then
+	setenv mmcdev 0
+elif mmc dev 1; then
+	setenv mmcdev 1
+fi
+
+part uuid mmc ${mmcdev}:${mmcrootpart} uuid
 
 # Boot from eMMC is the only supported option
 setenv bootargs "${console} root=PARTUUID=${uuid} rw rootwait"
